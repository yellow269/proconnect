# Supabase - get these from https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key (for server-to-server webhooks like PayFast ITN)
# NEVER expose this to the client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL - used for PayFast callbacks (MUST use HTTPS in production)
NEXT_PUBLIC_SITE_URL=https://proconect.co.za

# PayFast - get these from https://www.payfast.co.za/dashboard
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

# PayFast callback URLs (optional - defaults to SITE_URL paths)
PAYFAST_RETURN_URL=https://proconect.co.za/dashboard/subscription?status=success
PAYFAST_CANCEL_URL=https://proconect.co.za/dashboard/subscription?status=cancelled
PAYFAST_NOTIFY_URL=https://proconect.co.za/api/payfast/notify
